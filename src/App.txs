import React, { useState } from 'react';
import { Check, Copy, Settings, Server, ShieldCheck, Zap } from 'lucide-react';

export default function App() {
  const [copied, setCopied] = useState<string | null>(null);

  const copyToClipboard = (text: string) => {
    navigator.clipboard.writeText(text);
    setCopied(text);
    setTimeout(() => setCopied(null), 2000);
  };

  return (
    <div className="min-h-screen bg-slate-900 text-slate-100 p-4 md:p-8 font-sans">
      <div className="max-w-2xl mx-auto space-y-6">
        {/* Header */}
        <div className="border-b border-slate-800 pb-5">
          <div className="flex items-center space-x-3 mb-1">
            <div className="p-2 bg-emerald-600 rounded-lg">
              <Server className="w-5 h-5 text-white" />
            </div>
            <h1 className="text-xl md:text-2xl font-bold">Vercel Setup for Your Express Project</h1>
          </div>
          <p className="text-slate-400 text-sm">
            You already have <code className="text-indigo-300 font-mono">vercel.json</code> and <code className="text-indigo-300 font-mono">server.js</code> in your GitHub repository!
          </p>
        </div>

        {/* Step 1: Settings */}
        <div className="bg-slate-800/90 rounded-xl p-5 border border-slate-700 shadow-lg space-y-4">
          <div className="flex items-center gap-2 text-emerald-400 font-semibold text-base">
            <Zap className="w-5 h-5" />
            <span>Vercel Build & Deployment Settings</span>
          </div>

          <div className="space-y-3 text-sm">
            {/* Framework Preset */}
            <div className="bg-slate-950 p-3 rounded-lg border border-slate-800 flex justify-between items-center">
              <div>
                <div className="text-xs text-slate-400 uppercase font-medium">Framework Preset</div>
                <div className="text-slate-200 font-semibold mt-0.5">Other</div>
              </div>
              <span className="text-xs text-slate-400 bg-slate-800 px-2.5 py-1 rounded">Default</span>
            </div>

            {/* Build Command */}
            <div className="bg-slate-950 p-3 rounded-lg border border-slate-800 flex justify-between items-center">
              <div>
                <div className="text-xs text-slate-400 uppercase font-medium">Build Command</div>
                <div className="text-amber-400 font-semibold text-xs mt-0.5">OFF (Disabled)</div>
              </div>
              <span className="text-xs text-slate-400">Leave empty (Do not override)</span>
            </div>

            {/* Output Directory */}
            <div className="bg-slate-950 p-3 rounded-lg border border-slate-800 flex justify-between items-center">
              <div>
                <div className="text-xs text-slate-400 uppercase font-medium">Output Directory</div>
                <div className="text-amber-400 font-semibold text-xs mt-0.5">OFF (Disabled)</div>
              </div>
              <span className="text-xs text-slate-400">Leave empty (Do not override)</span>
            </div>

            {/* Install Command */}
            <div className="bg-slate-950 p-3 rounded-lg border border-slate-800 flex justify-between items-center">
              <div>
                <div className="text-xs text-slate-400 uppercase font-medium">Install Command</div>
                <code className="text-indigo-300 font-mono text-xs mt-0.5 block">npm install</code>
              </div>
              <button
                onClick={() => copyToClipboard('npm install')}
                className="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 rounded text-xs font-medium text-slate-200 flex items-center gap-1 transition-colors"
              >
                {copied === 'npm install' ? <Check className="w-3.5 h-3.5 text-emerald-400" /> : <Copy className="w-3.5 h-3.5" />}
                {copied === 'npm install' ? 'Copied' : 'Copy'}
              </button>
            </div>
          </div>
        </div>

        {/* Step 2: Environment Variables */}
        <div className="bg-slate-800/90 rounded-xl p-5 border border-slate-700 shadow-lg space-y-3">
          <div className="flex items-center gap-2 text-indigo-400 font-semibold text-base">
            <ShieldCheck className="w-5 h-5" />
            <span>Environment Variables (Optional)</span>
          </div>
          <p className="text-xs text-slate-300">
            Go to <strong>Settings &gt; Environment Variables</strong> in Vercel and add your password:
          </p>
          <div className="bg-slate-950 p-3 rounded-lg border border-slate-800 space-y-1 font-mono text-xs">
            <div className="text-slate-400">Key: <span className="text-indigo-300 font-bold">SITE_PASSWORD</span></div>
            <div className="text-slate-400">Value: <span className="text-emerald-300 font-bold">Y##</span></div>
          </div>
        </div>

        {/* Redeploy Notice */}
        <div className="bg-emerald-950/40 rounded-xl p-4 border border-emerald-800/50 flex items-center gap-3">
          <div className="w-7 h-7 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-xs shrink-0">
            ✓
          </div>
          <div className="text-xs text-emerald-200">
            Since your project has <code className="font-mono bg-emerald-900/60 px-1 rounded">vercel.json</code>, Vercel automatically deploys your Express server &amp; frontend static files without any extra build commands!
          </div>
        </div>
      </div>
    </div>
  );
}


