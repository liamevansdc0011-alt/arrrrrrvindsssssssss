import React from 'react';
import { AlertTriangle, CheckCircle, FileCode, Folder } from 'lucide-react';

export default function App() {
  const fileFixes = [
    { old: 'public/index', new: 'public/index.html', reason: 'Critical! Without .html extension, Vercel downloads the file instead of opening the website.', urgent: true },
    { old: 'server', new: 'server.js', reason: 'Needed so Vercel can run your Node/Express backend.', urgent: true },
    { old: 'vercel', new: 'vercel.json', reason: 'Needed so Vercel knows how to route your server.', urgent: true },
    { old: 'package', new: 'package.json', reason: 'Needed for dependencies like express and nodemailer.', urgent: true },
    { old: 'gitignore', new: '.gitignore', reason: 'Standard dot-file for git.', urgent: false },
    { old: 'src/App.txs', new: 'Delete or rename to App.tsx', reason: 'Wrong extension (.txs instead of .tsx).', urgent: false },
  ];

  return (
    <div className="min-h-screen bg-slate-900 text-slate-100 p-4 md:p-8 font-sans">
      <div className="max-w-2xl mx-auto space-y-6">
        {/* Header */}
        <div className="border-b border-slate-800 pb-5">
          <div className="flex items-center space-x-3 mb-2">
            <div className="p-2 bg-amber-500 rounded-lg text-slate-950 font-bold">
              <AlertTriangle className="w-6 h-6" />
            </div>
            <div>
              <h1 className="text-xl md:text-2xl font-bold text-amber-400">File Name Errors Found in GitHub!</h1>
              <p className="text-slate-400 text-xs mt-0.5">
                This is why your Vercel link downloads a file instead of opening the website.
              </p>
            </div>
          </div>
        </div>

        {/* Main Problem Highlight */}
        <div className="bg-red-950/40 border border-red-800/80 rounded-xl p-4 flex gap-3 items-start">
          <AlertTriangle className="w-5 h-5 text-red-400 shrink-0 mt-0.5" />
          <div className="text-xs text-red-200 space-y-1">
            <span className="font-bold text-sm block text-red-300">Why was the website downloading?</span>
            In your GitHub <code className="bg-red-900/60 px-1.5 py-0.5 rounded font-mono">public</code> folder, the file is named <code className="bg-red-900/60 px-1.5 py-0.5 rounded font-mono">index</code> (missing <code className="text-amber-300 font-bold">.html</code>). 
            When Vercel sees <code className="font-mono">index</code> without <code className="font-mono">.html</code>, it forces browser to <strong>DOWNLOAD</strong> the file instead of displaying it as a webpage!
          </div>
        </div>

        {/* Fix Checklist */}
        <div className="bg-slate-800/90 rounded-xl p-5 border border-slate-700 shadow-lg space-y-4">
          <h2 className="text-sm font-semibold text-slate-200 uppercase tracking-wider flex items-center gap-2">
            <Folder className="w-4 h-4 text-indigo-400" />
            <span>Rename these files in GitHub (GitHub pe in names ko fix karein):</span>
          </h2>

          <div className="space-y-3">
            {fileFixes.map((item, index) => (
              <div key={index} className="bg-slate-950 p-3 rounded-lg border border-slate-800 space-y-1 text-xs">
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-2">
                    <span className="text-red-400 line-through font-mono font-medium">{item.old}</span>
                    <span className="text-slate-500">➔</span>
                    <span className="text-emerald-400 font-mono font-bold bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-800/50">
                      {item.new}
                    </span>
                  </div>
                  {item.urgent && (
                    <span className="bg-amber-500/10 text-amber-400 text-[10px] px-2 py-0.5 rounded border border-amber-500/20 font-medium">
                      Must Rename
                    </span>
                  )}
                </div>
                <p className="text-slate-400 text-[11px] pt-1">{item.reason}</p>
              </div>
            ))}
          </div>
        </div>

        {/* Success Note */}
        <div className="bg-emerald-950/40 border border-emerald-800/50 rounded-xl p-4 flex gap-3 items-center">
          <CheckCircle className="w-5 h-5 text-emerald-400 shrink-0" />
          <div className="text-xs text-emerald-200">
            Jaise hi aap GitHub par <code className="font-mono bg-emerald-900/60 px-1 rounded">public/index</code> ko rename karke <code className="font-mono bg-emerald-900/60 px-1 rounded font-bold text-emerald-300">index.html</code> kar denge, Vercel par aapki website bina download huye direct open hone lagegi!
          </div>
        </div>
      </div>
    </div>
  );
}



